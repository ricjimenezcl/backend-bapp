# Archivo de ejemplo .env para el backend FastAPI
# Copia este archivo como .env en backend/app/ o en la raíz del backend

# Clave secreta para JWT (cámbiala por una segura en producción)
SECRET_KEY=super-secret-key-cambia-esto

# Algoritmo JWT
ALGORITHM=HS256

# Cadena de conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/bapp_db

# URL de Redis para el event bus
REDIS_URL=redis://localhost:6379/0

# (Opcional) Configuración de Cloudinary, email, etc.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# EMAIL_HOST=smtp.tuemail.com
# EMAIL_USER=usuario
# EMAIL_PASSWORD=contraseña
